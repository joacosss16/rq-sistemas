# A qué base de datos se conecta esta copia de la app.
# Copia este archivo como .env.local y pon los valores del proyecto de PRUEBAS.
# Nunca pongas aquí los datos de producción: .env.local no se sube al repositorio.
#
# Los valores salen de Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO-DE-PRUEBAS.supabase.co
VITE_SUPABASE_ANON_KEY=la-anon-key-del-proyecto-de-pruebas

# 'pruebas' o 'produccion'. Si dice pruebas, la app muestra un aviso
# permanente en pantalla para que nadie confunda un entorno con el otro.
VITE_ENTORNO=pruebas
